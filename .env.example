PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# The account that signs up with this email becomes admin
ADMIN_EMAIL=you@example.com
# Razorpay keys (https://dashboard.razorpay.com/app/keys). Leave empty for DEMO mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Used only if the live exchange-rate API is unreachable
FALLBACK_USD_INR=84
# Re-import jobs from Remotive/Himalayas every 6 hours
AUTO_IMPORT=false
NODE_ENV=development
# Free applications every new user gets before needing a pass
FREE_APPLIES=2
